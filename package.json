{
  "name": "the-corruptor",
  "version": "1.0.0",
  "description": "Corruption Education Simulator",
  "scripts": {
    "install:all": "npm install --prefix frontend && pip install -r backend/requirements.txt",
    "start:frontend": "npm run dev --prefix frontend",
    "start:backend": "cd backend && uvicorn app.main:app --reload",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
